{
  "name": "vam-website",
  "version": "1.0.0",
  "description": "Viral Ads Media Website",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:css dev:server",
    "dev:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./src/style.css --watch",
    "dev:server": "browser-sync start --server --files './**/*.{html,css,js}'",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./src/style.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "browser-sync": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.1"
  },
  "dependencies": {
    "cloudinary": "^2.10.0"
  }
}
